graph LR
    A[(S3/InfluxDB/Postgres)] --> B[TimeSeriesDataset]
    B --> C[CompletenessChecker]
    C --> D[FlatlineChecker]
    D --> E[InputConsistencyChecker]
    E --> F[ForecastInputDataset]
    F --> G[Model Predict]
    G --> H[(Store ForecastDataset)]
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class B,F,G primary
    class A,H secondary
    class C,D,E accent