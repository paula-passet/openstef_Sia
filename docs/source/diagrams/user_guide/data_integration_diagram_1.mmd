graph LR
    A[(Local Parquet)] --> D[VersionedTimeSeriesDataset]
    B[(S3 Parquet)] --> D
    C[(Azure Blob Parquet)] --> D
    D -->|concat mode=left| E[Combined Versioned Dataset]
    E -->|select_version| F[TimeSeriesDataset]
    F --> G[Training Pipeline]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C accent
    class D,E secondary
    class F,G primary