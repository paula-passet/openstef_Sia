graph LR
    A[MV Node Forecasters] --> B[Per-Node Load Forecasts]
    B --> C{Power-Grid-Model}
    D[(Network Topology)] --> C
    E([Switch States]) --> C
    C --> F[Cable Loading %]
    F --> G[Congested Segments]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B primary
    class C,D secondary
    class E accent
    class F,G primary