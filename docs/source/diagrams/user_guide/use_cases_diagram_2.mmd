graph LR
    A[MV Node Forecasts] --> B[Per-Node XGBoost Model]
    B --> C[Probabilistic Output]
    C --> D[Topology Layer]
    E[(Network Topology)] --> D
    D --> F[Power Flow Calc]
    F --> G[Route Loading]
    G --> H[Congestion Probability]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C primary
    class D,F secondary
    class E accent
    class G,H primary