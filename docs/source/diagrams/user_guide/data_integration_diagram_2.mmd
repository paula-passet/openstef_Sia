graph LR
    A[(S3 Load Parquet)] --> C[VersionedDataset concat]
    B[(S3 Weather Parquet)] --> C
    C --> D[Completeness Check]
    D --> E[Flatline Check]
    E --> F[workflow predict]
    F --> G[(S3 Forecast Parquet)]
    F --> H[(PostgreSQL forecasts)]
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class C,D,E,F primary
    class G,H secondary
    class A,B accent