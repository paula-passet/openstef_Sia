graph TD
    A([Scheduled Script]) -->|add containers| B([Containerised Job])
    B -->|add orchestration| C([Orchestration Platform])

    A1[Cron; CI/CD; Cloud Scheduler] --> A
    B1[Docker; Kubernetes; ECS] --> B
    C1[Airflow; Prefect; DAGs] --> C

    SCALE[Scale and Complexity] -.->|increases| C

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C primary
    class A1,B1,C1 accent
    class SCALE secondary