graph TD
    A[V3 Single Package] --> B[openstef]
    B --> C[Data Classes]
    B --> D[Pipelines]
    B --> E[Models]

    F[V4 Modular Packages] --> G[openstef-core]
    F --> H[openstef-models]
    F --> I[openstef-beam]

    G -->|depends on| H
    H -->|depends on| I

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,F primary
    class B secondary
    class C,D,E accent
    class G,H,I secondary