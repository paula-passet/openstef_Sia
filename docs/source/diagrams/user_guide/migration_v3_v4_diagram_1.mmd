graph LR
    A[ForecastingWorkflowConfig] --> B[create_forecasting_workflow]
    B --> C[ForecastingModel]
    C --> D[Preprocessing]
    D --> E[Forecaster]
    E --> F[Postprocessing]
    F --> G[MLFlowStorageCallback]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B primary
    class C secondary
    class D,E,F accent
    class G secondary