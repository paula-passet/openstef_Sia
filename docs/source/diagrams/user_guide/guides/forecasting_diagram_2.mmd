graph TD
    A[Preset] --> B[Workflow]
    B --> C[Model]
    C --> D[Forecaster]

    A -.->|"Less boilerplate"| UP[ ]
    D -.->|"More control"| DOWN[ ]

    style UP fill:none,stroke:none
    style DOWN fill:none,stroke:none

    E[/"Less boilerplate ↑"/] --- A
    D --- F[\"More control ↓"\]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    classDef hidden fill:none,stroke:none,color:none

    class A primary
    class B accent
    class C accent
    class D secondary
    class E primary
    class F secondary
    class UP,DOWN hidden