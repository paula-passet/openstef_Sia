graph TD
    A[TimeSeriesDataset Part 1] --> D[VersionedTimeSeriesDataset]
    B[TimeSeriesDataset Part 2] --> D
    C[TimeSeriesDataset Part N] --> D
    D -->|select_version| E[Single TimeSeriesDataset Snapshot]
    E --> F[Model Training or Backtest]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C primary
    class D secondary
    class E,F accent