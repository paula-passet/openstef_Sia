graph LR
    A([Input Data]) --> B[Preprocessing Pipeline]
    subgraph FM[ForecastingModel]
        B --> T1(Transform 1)
        T1 --> T2(Transform 2)
        T2 --> T3(Transform 3)
        T3 --> C[Forecaster]
        C --> T4(Transform 4)
        T4 --> T5(Transform 5)
        T5 --> D[Postprocessing Pipeline]
    end
    D --> E([Forecast Output])
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class A,E primary
    class C secondary
    class T1,T2,T3,T4,T5 accent
    class B,D primary