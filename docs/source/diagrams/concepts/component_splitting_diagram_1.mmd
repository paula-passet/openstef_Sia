graph LR
    A([Aggregate Load]) --> B[ComponentSplitter]
    B --> C[Wind Component]
    B --> D[Solar Component]
    B --> E[Other Component]
    C --> F[Wind Forecast Model]
    D --> G[Solar Forecast Model]
    E --> H[Demand Forecast Model]
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class A primary
    class B secondary
    class C,D,E accent
    class F,G,H primary