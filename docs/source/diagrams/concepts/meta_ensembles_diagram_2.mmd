graph LR
    A[Base Forecaster 1] --> D[Stacked Input Matrix]
    B[Base Forecaster 2] --> D
    C[Base Forecaster N] --> D
    D -->|quantile q| E[Meta-Regressor for q]
    E --> F[Final q-th Quantile]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C accent
    class D primary
    class E secondary
    class F primary