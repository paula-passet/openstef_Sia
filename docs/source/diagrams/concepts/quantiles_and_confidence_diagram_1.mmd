graph TD
    A([Forecast Horizon: 48h]) --> B[P50 Median Forecast]
    B --> C[Inner Band: P25-P75]
    B --> D[Outer Band: P10-P90]
    C --> E[Narrow Uncertainty]
    D --> F[Wide Uncertainty]
    E --> G([Early Horizon])
    F --> H([Late Horizon])
    H --> I[(80% Outcomes in Band)]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B primary
    class C,D secondary
    class E,F,G,H accent
    class I secondary