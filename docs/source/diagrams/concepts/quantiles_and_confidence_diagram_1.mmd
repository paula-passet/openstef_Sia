graph TD
    A[Hours Ahead: t] --> B[Apply Saturation Curve]
    B --> C["σ-t = a x 1 - exp-t/τ + b"]
    C --> D[Uncertainty σ]
    D --> E[Compute Z-score Offsets]
    E --> F["P10 = median - 1.28 x σ"]
    E --> G["P90 = median + 1.28 x σ"]
    F --> H[Forecast with Intervals]
    G --> H

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C primary
    class D,E secondary
    class F,G,H accent