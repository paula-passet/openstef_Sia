graph LR
    A[Forecast Start] --> B[P50 Central Line]
    B --> C[P30 to P70 Band]
    C --> D[P10 to P90 Band]
    D --> E[Wider Uncertainty]

    B --> F[Point Estimate]
    C --> G[Dark Shading]
    D --> H[Light Shading]
    E --> I[Long Horizon]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B primary
    class C,D secondary
    class E,F,G,H,I accent