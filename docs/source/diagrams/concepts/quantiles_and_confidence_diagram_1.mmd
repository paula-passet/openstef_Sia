graph TD
    A([Forecast Start]) --> B[P90 Upper Bound]
    A --> C[P50 Median Line]
    A --> D[P10 Lower Bound]
    B --> E[Wide Band P10-P90]
    D --> E
    C --> F[Narrow Band P25-P75]
    E --> G[80% Prediction Interval]
    F --> G
    G --> H[Actual vs Forecast]
    H --> I([Uncertainty Grows])

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,C primary
    class B,D,E,F secondary
    class G,H,I accent