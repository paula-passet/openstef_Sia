graph LR
    A[Raw Load Data] --> E[LagsAdder]
    B[Weather Data] --> F[WeatherFeatures]
    C[Datetime Index] --> G[CyclicFeaturesAdder]
    C --> H[HolidayFeatureAdder]
    E --> I[Feature Matrix]
    F --> I
    G --> I
    H --> I
    I --> J[Forecaster]
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class E,F,G,H primary
    class I,J secondary
    class A,B,C accent