graph TD
    A([ComponentSplitter - Abstract])
    B[ConstantComponentSplitter]
    C[LinearComponentSplitter]
    D[MyCustomSplitter]
    E[config property]
    F[fit method]
    G[predict method]
    H[is_fitted property]

    A --> B
    A --> C
    A -->|user-defined| D
    A --- E
    A --- F
    A --- G
    A --- H

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A primary
    class B,C secondary
    class D accent
    class E,F,G,H accent