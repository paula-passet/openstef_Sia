graph TD
    A[Input Data] --> B[Data Validation]
    B -->|valid| C[Model Inference]
    B -->|ValidationException| D[Log and Reject]
    C -->|success| E[Forecast Output]
    C -->|ModelException| F[Fallback Decision]
    F -->|baseline available| G[Baseline Model]
    F -->|no fallback| H[Raise Exception]
    G --> E

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C primary
    class E,G secondary
    class D,F,H accent