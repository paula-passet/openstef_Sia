graph TD
    A[Input Data] --> B[CompletenessChecker]
    B -->|pass| C[FlatlineChecker]
    B -->|fail| F[BaseCaseForecaster]
    C -->|pass| D[InputConsistencyChecker]
    C -->|fail| F
    D -->|pass| E[Primary Model]
    D -->|fail| F
    E --> G[Forecast Output]
    F --> G

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C,D primary
    class E,F secondary
    class G accent