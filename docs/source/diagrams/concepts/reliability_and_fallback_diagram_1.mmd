graph TD
    A[Incoming Data] --> B[Data Validation]
    B -->|valid| C[Primary Model Inference]
    B -->|invalid data| E[BaseCaseForecaster]
    C -->|success| D[Forecast Output]
    C -->|model error| E[BaseCaseForecaster]
    C -->|data drift| E[BaseCaseForecaster]
    E --> F[Baseline Forecast]
    F --> D

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B primary
    class C,E secondary
    class D,F accent