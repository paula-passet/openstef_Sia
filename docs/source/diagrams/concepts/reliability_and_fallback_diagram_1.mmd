graph TD
    A([New Model Trained]) --> B[Evaluate Metrics]
    B --> C[Apply Penalty to Old Score]
    C --> D{New Model Wins?}
    D -->|Yes| E[Promote New Model]
    D -->|No| F[Retain Old Model]
    F --> G[Log Warning]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B,C primary
    class E,F secondary
    class D,G accent