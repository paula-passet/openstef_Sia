graph TD
    A([Forecast Request]) --> B[Validate Input Data]
    B -->|invalid| C[Log Data Error]
    B -->|valid| D{Model Available?}
    D -->|no| E[Fallback Cascade]
    D -->|yes| F[Primary Forecast]
    F -->|success| G([Return Forecast])
    F -->|failure| E
    E --> H[Base-Case Forecaster]
    H --> G
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class A,G primary
    class D,F secondary
    class B,C,E,H accent