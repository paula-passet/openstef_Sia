graph TD
    A[Primary Model Attempt] --> B{Data Complete?}
    B -->|Yes| C[Generate Forecast]
    B -->|No| D{Partial Data?}
    D -->|Yes| E[BaseCaseForecaster]
    D -->|No| F[All Sources Exhausted]
    E --> G[Fallback Forecast]
    F --> H[Return NaN]
    C --> I[(Store Results)]
    G --> I

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,C,E primary
    class B,D secondary
    class F,G,H,I accent