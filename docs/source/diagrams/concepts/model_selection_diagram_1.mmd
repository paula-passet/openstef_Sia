graph TD
    A([Start: Select Model]) --> B{Enough Training Data?}
    B -->|No| C[Linear Regression]
    B -->|Yes| D{Non-linear Patterns?}
    D -->|No| C
    D -->|Yes| E{Low Latency Needed?}
    E -->|Yes| F[XGBoost]
    E -->|No| G{Interpretability?}
    G -->|Yes| F
    G -->|No| H[LightGBM or Neural Net]
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class A primary
    class B,D,E,G accent
    class C,F,H secondary