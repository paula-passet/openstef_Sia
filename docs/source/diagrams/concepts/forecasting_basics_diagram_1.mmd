graph LR
    A([Now - Available At]) --> B[15 min Horizon]
    A --> C[1 h Horizon]
    A --> D[24 h Horizon]
    A --> E[48 h Horizon]
    B -->|low uncertainty| F([Target T+15min])
    C -->|moderate uncertainty| G([Target T+1h])
    D -->|high uncertainty| H([Target T+24h])
    E -->|highest uncertainty| I([Target T+48h])
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class A primary
    class B,C,D,E secondary
    class F,G,H,I accent