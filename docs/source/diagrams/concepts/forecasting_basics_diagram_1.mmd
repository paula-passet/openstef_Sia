graph LR
    A([Every 15 min tick]) --> B[NOW anchor]
    B --> C[PT15M horizon]
    B --> D[PT1H horizon]
    B --> E[PT24H horizon]
    B --> F[PT48H horizon]
    G[(Data cutoff)] --> B
    C --> H([Near-term forecast])
    F --> I([Long-term forecast])
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class B,C,D primary
    class E,F,G secondary
    class A,H,I accent