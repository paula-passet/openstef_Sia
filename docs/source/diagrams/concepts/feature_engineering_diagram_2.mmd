graph LR
    A[(Raw Dataset)] --> B[Weather Features]
    B --> C[Time Features]
    C --> D[Lag and Rolling Features]
    D --> E[Final Feature Matrix]

    B:::accent -.->|"+ wind; radiation; atmos"| B
    C:::accent -.->|"+ cyclic; holiday; datetime"| C
    D:::accent -.->|"+ lags; rolling stats"| D

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class B,C,D primary
    class A,E secondary