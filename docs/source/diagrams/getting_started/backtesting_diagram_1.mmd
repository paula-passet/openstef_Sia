graph LR
    A([Historical Data]) --> B[Set Current Position]
    B --> C[Training Window]
    C --> D[Retrain Model]
    D --> E[Prediction Window]
    E --> F{Advance Position}
    F -->|next interval| B
    F -->|complete| G([Backtest Results])

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class C,D,E primary
    class A,G secondary
    class B,F accent