graph LR
    A([Start Backtest]) --> B[Set Training Window]
    B --> C[Train Model]
    C --> D[Forecast Next Horizon]
    D --> E[Compare vs Ground Truth]
    E --> F{Window End?}
    F -->|No| G[Slide Window Forward]
    G --> C
    F -->|Yes| H([Evaluate Metrics])
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class A,H primary
    class C,D secondary
    class B,E,G accent
    class F accent