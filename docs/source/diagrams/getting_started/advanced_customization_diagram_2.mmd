graph TD
    A[User Code] -->|train| B[workflow.train]
    B -->|model.fit| C[ForecastingModel]
    C --> D[preprocessing\nfit_transform]
    D --> E[forecaster.fit]
    E --> F[postprocessing.fit]
    A -->|predict| G[workflow.predict]
    G -->|model.predict| C
    C --> H[preprocessing\ntransform]
    H --> I[forecaster.predict]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A primary
    class B,G secondary
    class C primary
    class D,E,F accent
    class H,I accent