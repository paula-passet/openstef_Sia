graph LR
    A[(Raw Input Data)] --> B[Preprocessing Pipeline]
    B --> C[HolidayFeatures; LagTransform]
    C --> D[StandardScaler]
    D --> E[XGBForecaster]
    E --> F[Postprocessing Pipeline]
    F --> G[NonNegativeClip; QuantileSorter]
    G --> H[(Forecast Output)]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class B,F primary
    class E secondary
    class C,D,G accent
    class A,H secondary