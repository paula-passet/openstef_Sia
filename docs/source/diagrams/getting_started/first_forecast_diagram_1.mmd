graph LR
    A[(Raw Dataset)] --> B[TransformPipeline]
    B --> C[HolidayFeatureAdder]
    B --> D[LagTransform]
    B --> E[StandardScaler]
    C --> F[ForecastingModel]
    D --> F
    E --> F
    F --> G[CustomForecastingWorkflow]
    G --> H[fit / predict]
    H --> I[(ForecastDataset)]
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class A,I secondary
    class B,F,G primary
    class C,D,E,H accent