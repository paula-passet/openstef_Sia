graph LR
    A[(TimeSeriesDataset)] -->|raw time series| B[TransformPipeline]
    B -->|engineered features| C[ForecastingModel]
    C -->|model + transforms| D[CustomForecastingWorkflow]
    D -->|fit; predict calls| E([ForecastDataset])

    B1[HolidayFeatureAdder] --> B
    B2[LagsAdder; Scaler] --> B

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class B,C,D primary
    class A,E secondary
    class B1,B2 accent