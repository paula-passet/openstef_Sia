graph LR
    A[(VersionedTimeSeriesDataset)] --> B[TransformPipeline]
    B --> C[Selector]
    B --> D[LagsAdder]
    B --> E[HolidayAdder]
    B --> F[StandardScalerTransform]
    C & D & E & F --> G[ForecastingModel]
    G --> H[CustomForecastingWorkflow]
    H --> I[fit / predict]
    I --> J[(ForecastDataset)]
    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000
    class A,J secondary
    class B,G,H primary
    class C,D,E,F,I accent