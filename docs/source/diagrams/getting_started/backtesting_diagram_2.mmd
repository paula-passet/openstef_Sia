graph TD
    A[Multiple Substations] --> B[Compute rMAE]
    B --> C[Baseline Bars]
    B --> D[Candidate Bars]
    C --> E[GroupedTarget\nMetricViz]
    D --> E
    E --> F[Side-by-Side\nBar Chart]
    F --> G[Candidate Shorter\nThan Baseline]

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class A,B primary
    class C,D secondary
    class E,F,G accent