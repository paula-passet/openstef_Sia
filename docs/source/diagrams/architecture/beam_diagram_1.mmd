graph TD
    A[(VersionedTimeSeriesDataset)] --> B
    M[(ForecasterFactory)] --> B
    B[BacktestPipeline] -->|predictions DataFrame| C
    C[EvaluationPipeline] -->|SubsetMetrics| D
    D[EvaluationReport] --> E
    E[AnalysisPipeline] -->|VisualizationOutput| F
    F[BenchmarkPipeline]
    G[(TargetProvider)] --> F
    H[(BenchmarkStorage)] --> F

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class B,C,E,F primary
    class A,M,G,H secondary
    class D accent