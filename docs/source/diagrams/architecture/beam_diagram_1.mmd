graph TD
    A[BenchmarkPipeline] --> B[For each model x target]
    B --> C[BacktestPipeline]
    C -->|predictions| D[EvaluationPipeline]
    D -->|EvaluationReport| E[AnalysisPipeline]
    E --> F[Visualisations; Summary Tables]
    D --> G[(Store Results)]
    E --> G

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class C,D,E primary
    class A,G secondary
    class B,F accent