graph LR
    A[(openstef_core\nDatasets/Types)] --> B
    B[Transforms/Workflows] --> C
    D([openstef_beam\nDistributed Pipelines]) --> C
    C[EnsembleForecastingModel] --> E[Shared Preprocessing]
    E --> F[Base Forecaster 1]
    E --> G[Base Forecaster N]
    F --> H[ForecastCombiner]
    G --> H
    H --> I([Ensemble Output])

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class E,F,G,H primary
    class A,D secondary
    class B,C,I accent