graph LR
    A[(openstef_core\nBase Types)] --> B[Preprocessing]
    B --> C[Forecaster 1]
    B --> D[Forecaster N]
    C --> E[ForecastCombiner]
    D --> E[ForecastCombiner]
    F[(openstef_models)] --> C
    F --> D
    G[(openstef_beam\nMetrics)] --> H[EnsembleModel Output]
    E --> H

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class B,E,H primary
    class A,F,G secondary
    class C,D accent