graph TD
    A[(openstef_core)] --> B[transforms module]
    B --> C[FeaturePipeline]
    C --> D[ForecastingModel]
    D --> E[ExplainableForecaster]
    F([openstef_models.presets]) -->|wires all layers| C
    G[validation; general; time_domain] --> B
    H[weather_domain; energy_domain] --> B

    classDef primary fill:#00D9C5,stroke:#1E3A5F,stroke-width:2px,color:#000
    classDef secondary fill:#1E3A5F,stroke:#00D9C5,stroke-width:2px,color:#fff
    classDef accent fill:#e6f7f5,stroke:#00D9C5,stroke-width:2px,color:#000

    class C,D primary
    class A,E secondary
    class B,F,G,H accent